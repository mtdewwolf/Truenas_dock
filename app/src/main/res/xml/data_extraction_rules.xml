<?xml version="1.0" encoding="utf-8"?>
<!-- Server credentials are Keystore-encrypted and device-bound; never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
